generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MOYENS_GENERAUX
  REGULATEUR
  VIGILE
  DELEGUE
}

enum ReclamationCategory {
  CLIMATISATION
  MOBILIER
  ECLAIRAGE
  ELECTRICITE
  EQUIPEMENT
  PLOMBERIE
  PROPRETE
  AUTRE
}

enum ReclamationStatus {
  OUVERTE
  EN_COURS
  RESOLUE
  REJETEE
}

enum Priority {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

model User {
  id                    String             @id @default(uuid())
  fullName              String
  email                 String             @unique
  passwordHash          String
  mustChangePassword    Boolean            @default(true)
  role                  Role
  buildingId            String?
  building              Building?          @relation(fields: [buildingId], references: [id])
  programId             String?
  program               Program?           @relation(fields: [programId], references: [id])
  reportedReclamations  Reclamation[]      @relation("ReportedBy")
  assignedReclamations  Reclamation[]      @relation("AssignedReclamations")
  events                ReclamationEvent[]
  auditLogs             AuditLog[]
  createdAt             DateTime           @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Building {
  id    String @id @default(uuid())
  name  String @unique
  rooms Room[]
  users User[]
}

model Room {
  id           String        @id @default(uuid())
  number       String
  buildingId   String
  building     Building      @relation(fields: [buildingId], references: [id])
  reclamations Reclamation[]

  @@unique([buildingId, number])
}

model Program {
  id           String        @id @default(uuid())
  name         String        @unique
  users        User[]
  reclamations Reclamation[]
}

model Reclamation {
  id             String              @id @default(uuid())
  number         Int                 @unique @default(autoincrement())
  category       ReclamationCategory
  priority       Priority            @default(NORMALE)
  status         ReclamationStatus   @default(OUVERTE)
  description    String
  roomId         String
  room           Room                @relation(fields: [roomId], references: [id])
  programId      String
  program        Program             @relation(fields: [programId], references: [id])
  reportedById   String
  reportedBy     User                @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedToId   String?
  assignedTo     User?               @relation("AssignedReclamations", fields: [assignedToId], references: [id])
  events         ReclamationEvent[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  resolvedAt     DateTime?

  @@index([status])
  @@index([roomId])
}

model ReclamationEvent {
  id            String             @id @default(uuid())
  reclamationId String
  reclamation   Reclamation        @relation(fields: [reclamationId], references: [id], onDelete: Cascade)
  fromStatus    ReclamationStatus?
  toStatus      ReclamationStatus
  comment       String?
  authorId      String
  author        User               @relation(fields: [authorId], references: [id])
  createdAt     DateTime           @default(now())
}
